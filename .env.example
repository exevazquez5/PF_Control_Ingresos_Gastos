# Copia este archivo a ".env" (DEV local) y completa los valores.
# ".env" NO se sube al repositorio (esta en .gitignore).
# Los valores de PROD NO se guardan en la maquina: viven en los dashboards de
# Render/Supabase/Cloudflare (la cadena de Supabase para backups va en ".env.prod").

# Cadena de conexion PostgreSQL local (contenedor 'db' del docker-compose, puerto 5433)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=postgres;Username=postgres;Password=gastar_dev;SSL Mode=Disable;Trust Server Certificate=true;

# Clave JWT SOLO para DEV (distinta a la de PROD)
Jwt__Key=<clave_aleatoria_solo_dev>
Jwt__Issuer=tu_issuer
Jwt__Audience=tu_audience

# Brevo: vacio en DEV (el entorno local no envia emails)
Email__BrevoApiKey=
Email__SenderEmail=
Email__SenderName=GastAr

# Origenes permitidos por CORS (separados por coma): Vite, nginx local y tu red LAN
FrontendUrl=http://localhost:5173,http://localhost,http://192.168.1.46
