# Copia este archivo a ".env" y completa los valores reales.
# El archivo ".env" NO se sube al repositorio (esta en .gitignore).

# Cadena de conexion PostgreSQL (Supabase, session pooler puerto 5432)
ConnectionStrings__DefaultConnection=Host=<host>;Port=5432;Database=postgres;Username=<usuario>;Password=<password>;SSL Mode=Require;Trust Server Certificate=true;

# Clave secreta para firmar JWT (minimo 32 caracteres, aleatoria)
Jwt__Key=<clave_larga_y_aleatoria_de_32_o_mas_caracteres>
Jwt__Issuer=tu_issuer
Jwt__Audience=tu_audience

# Brevo (https://app.brevo.com -> SMTP & API -> API Keys)
Email__BrevoApiKey=<brevo_api_key>
Email__SenderEmail=<email_verificado_como_sender>
Email__SenderName=GastAr

# Origen(es) permitidos por CORS / URL de la SPA (separados por coma)
FrontendUrl=http://localhost:5173
